        {"name": "CUFFT_R2C", "value": "42", "source": "cufft.h"},
        {"name": "CUFFT_C2R", "value": "44", "source": "cufft.h"},
        {"name": "CUFFT_C2C", "value": "41", "source": "cufft.h"}
      ],
      "validated": true,
      "iterations": 0,
      "recipe": "#include <cufft.h>\n#include <cuda_runtime.h>\n#include <stdio.h>\n\n#define CUFFT_CHECK(call) { cufftResult e = call; if (e != CUFFT_SUCCESS) { fprintf(stderr, \"cuFFT error %d at %s:%d\\n\", e, __FILE__, __LINE__); exit(1); } }\n\nvoid gpu_rfft(const float* input, cufftComplex* output, int n) {\n    cufftHandle plan;\n    CUFFT_CHECK(cufftPlan1d(&plan, n, CUFFT_R2C, 1));\n    float* d_input;\n    cufftComplex* d_output;\n    cudaMalloc(&d_input, n * sizeof(float));\n    cudaMalloc(&d_output, (n/2+1) * sizeof(cufftComplex));\n    cudaMemcpy(d_input, input, n * sizeof(float), cudaMemcpyHostToDevice);\n    CUFFT_CHECK(cufftExecR2C(plan, d_input, d_output));\n    cudaMemcpy(output, d_output, (n/2+1) * sizeof(cufftComplex), cudaMemcpyDeviceToHost);\n    cufftDestroy(plan);\n    cudaFree(d_input);\n    cudaFree(d_output);\n}"
    }
