      "constants": [],
      "validated": true,
      "iterations": 1,
      "recipe": "import ctypes\nimport ctypes.util\nvt = ctypes.CDLL(ctypes.util.find_library('VideoToolbox'))\ncm = ctypes.CDLL(ctypes.util.find_library('CoreMedia'))\ncv = ctypes.CDLL(ctypes.util.find_library('CoreVideo'))\n# Create format description from H.264 SPS/PPS\nfmt_desc = ctypes.c_void_p()\n# Create decompression session\nsession = ctypes.c_void_p()\nstatus = vt.VTDecompressionSessionCreate(None, fmt_desc, None, None, None, ctypes.byref(session))\nassert status == 0\n# Decode frames...\nvt.VTDecompressionSessionDecodeFrame(session, sample_buf, 0, None, None)\nvt.VTDecompressionSessionWaitForAsynchronousFrames(session)\nvt.VTDecompressionSessionInvalidate(session)"
    },
