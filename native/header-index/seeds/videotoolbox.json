      "constants": [],
      "validated": true,
      "iterations": 1,
      "recipe": "import ctypes\nimport ctypes.util\nvt = ctypes.CDLL(ctypes.util.find_library('VideoToolbox'))\n# Create compression session (H.264, 1920x1080)\nsession = ctypes.c_void_p()\nkCMVideoCodecType_H264 = 0x61766331  # 'avc1'\nstatus = vt.VTCompressionSessionCreate(None, 1920, 1080, kCMVideoCodecType_H264, None, None, None, None, None, ctypes.byref(session))\nassert status == 0\nvt.VTCompressionSessionPrepareToEncodeFrames(session)\n# Encode frames...\nvt.VTCompressionSessionEncodeFrame(session, pixel_buffer, pts, duration, None, None, None)\nvt.VTCompressionSessionCompleteFrames(session, 0)\nvt.VTCompressionSessionInvalidate(session)"
